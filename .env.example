# Project URL: Supabase Dashboard → Settings → Data API → Project URL
# Пример: https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Publishable / anon key: Settings → API Keys
# Подходит ключ sb_publishable_... (вкладка Publishable) или legacy anon JWT (eyJ...)
# Не используйте secret key — он не должен попадать во фронтенд.
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
